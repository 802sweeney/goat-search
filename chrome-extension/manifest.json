{
  "manifest_version": 3,
  "name": "Goat Search — Capture JD",
  "version": "1.0",
  "description": "Capture the job description on the current page into your Goat Search tracker.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capture this job into Goat Search",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
